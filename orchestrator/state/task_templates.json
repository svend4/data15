      "name": "Full Pipeline",
      "category": "agents",
      "description": "Full multi-agent pipeline: CAMEL decompose → OpenClaw research → Hermes analyze → Multica save",
      "fields": {
        "goal": {
          "type": "textarea",
          "required": true,
          "label": "Pipeline Goal"

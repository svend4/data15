      },
      "defaults": {
        "agent": "Hermes",
        "priority": "high",
        "tags": ["pipeline", "multi-agent", "full"]
      },
      "version": 1,
      "created": "2026-05-05T00:00:00Z"
    }
  ],
    {
      "id": 8,
      "name": "Stress Test",
      "category": "testing",
      "description": "Ephemeral load/concurrency test task — auto-deleted after completion",
      "fields": {
        "title": {"type": "string", "required": true, "label": "Test Name"},

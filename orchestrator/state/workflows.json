{
  "workflows": [
    {
      "id": 1,
      "name": "Test Workflow",
      "description": "Basic test workflow",
      "steps": [
        {"name": "create", "type": "action", "action": "create_task", "title": "Test Task", "agent": "Hermes"},
        {"name": "wait",   "type": "delay",  "seconds": 1},
        {"name": "done",   "type": "action", "action": "update_status", "status": "completed"}
      ],
      "created": "2026-05-04T23:00:00Z"
    },
    {
      "id": 2,
      "name": "research_and_analyze",
      "description": "OpenClaw ищет данные во внешних источниках, Hermes анализирует и синтезирует итоговый отчёт.",
      "steps": [
        {
          "name": "external_search",
          "type": "action",
          "action": "call_openclaw",
          "prompt": "Search and summarize information about: {goal}",
          "critical": true
        },
        {
          "name": "internal_analysis",
          "type": "action",
          "action": "call_hermes",
          "prompt": "Analyze and provide insights on the following research data:\n\n{openclaw_result}\n\nOriginal goal: {goal}",
          "critical": true
        },
        {
          "name": "save_result",
          "type": "action",
          "action": "create_task",
          "title": "Research result: {goal}",
          "agent": "Hermes",
          "priority": "medium"
        },
        {
          "name": "notify_done",
          "type": "action",
          "action": "notify",
          "channel": "research_and_analyze",
          "message": "Workflow complete for goal: {goal}",
          "level": "info"
        }
      ],
      "created": "2026-05-05T00:00:00Z"
    },
    {
      "id": 3,
      "name": "decompose_and_execute",
      "description": "CAMEL декомпозирует цель на подзадачи, Multica создаёт их на доске, агенты выполняют параллельно.",
      "steps": [
        {
          "name": "decompose_goal",
          "type": "action",
          "action": "call_camel",
          "goal": "{goal}",
          "depth": 3,
          "critical": true
        },
        {
          "name": "create_in_multica",
          "type": "action",
          "action": "call_multica",
          "title": "Decomposed: {goal}",
          "agent": "Hermes",
          "priority": "high"
        },
        {
          "name": "execute_research_phase",
          "type": "action",
          "action": "call_openclaw",
          "prompt": "Research phase for: {goal}"
        },
        {
          "name": "execute_analysis_phase",
          "type": "action",
          "action": "call_hermes",
          "prompt": "Analysis phase. Goal: {goal}\nResearch data: {openclaw_result}"
        },
        {
          "name": "finalize",
          "type": "action",
          "action": "notify",
          "channel": "decompose_and_execute",
          "message": "All phases complete for: {goal}",
          "level": "info"
        }
      ],
      "created": "2026-05-05T00:00:00Z"
    },
    {
      "id": 4,
      "name": "monitor_and_report",
      "description": "Проверяет здоровье системы, собирает метрики и отправляет уведомление.",
      "steps": [
        {
          "name": "health_check",
          "type": "action",
          "action": "create_task",
          "title": "System health check",
          "agent": "Hermes",
          "priority": "low"
        },
        {
          "name": "run_hermes_check",
          "type": "action",
          "action": "call_hermes",
          "prompt": "Check system status and summarize: board tasks, active agents, recent errors."
        },
        {
          "name": "update_done",
          "type": "action",
          "action": "update_status",
          "status": "completed"
        },
        {
          "name": "notify_report",
          "type": "action",
          "action": "notify",
          "channel": "monitor_and_report",
          "message": "Health report ready: {hermes_result}",
          "level": "info"
        }
      ],
      "created": "2026-05-05T00:00:00Z"
    },
    {
      "id": 5,
      "name": "full_pipeline",
      "description": "Полный пайплайн: CAMEL декомпозирует → OpenClaw исследует → Hermes анализирует → Multica сохраняет.",
      "steps": [
        {
          "name": "decompose",
          "type": "action",
          "action": "call_camel",
          "goal": "{goal}",
          "depth": 3,
          "critical": true
        },
        {
          "name": "research",
          "type": "action",
          "action": "run_skill",
          "skill": "openclaw_web_search"
        },
        {
          "name": "analyze",
          "type": "action",
          "action": "call_hermes",
          "prompt": "Full analysis. Goal: {goal}\nCAMEL tasks: {camel_tasks}\nResearch: {openclaw_result}"
        },
        {
          "name": "combine",
          "type": "action",
          "action": "run_skill",
          "skill": "combine_results"
        },
        {
          "name": "persist_multica",
          "type": "action",
          "action": "call_multica",
          "title": "Pipeline result: {goal}",
          "agent": "Hermes",
          "priority": "high"
        },
        {
          "name": "done_notify",
          "type": "action",
          "action": "notify",
          "channel": "full_pipeline",
          "message": "Full pipeline complete: {goal}",
          "level": "info"
        }
      ],
      "created": "2026-05-05T00:00:00Z"
    }
  ],
  "executions": []
}
